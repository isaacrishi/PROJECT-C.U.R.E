{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Project C.U.R.E.",
  "version": "0.1.0",
  "identifier": "com.isaacrishi.projectcure",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Project C.U.R.E.",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": [
      "../dist/**/*",
      "../server.ts",
      "../server/**/*",
      "../package.json",
      "../node_modules/**/*"
    ]
  }
}

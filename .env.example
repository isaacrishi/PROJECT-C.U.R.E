# GEMINI_API_KEY: Required for server-side Gemini AI Research Engine calls.
# Configured via Secrets in AI Studio or environment variables on the server.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign researcher authentication tokens (auto-generated fallback used in local dev if omitted).
SESSION_SECRET="CHANGE_ME_IN_PRODUCTION"

# NCBI_API_KEY: Optional NCBI E-utilities API key for higher PubMed rate limits (10 req/s vs 3 req/s).
NCBI_API_KEY=""

# CURE_DB_PATH: Optional path to SQLite database file (defaults to ./data/cure.db).
CURE_DB_PATH="./data/cure.db"

# CURE_UPLOAD_DIR: Optional directory for uploaded datasets and pathology images (defaults to ./data/uploads).
CURE_UPLOAD_DIR="./data/uploads"
